# Groq LPU API Key
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Internal FastAPI Gateway Security
INTERNAL_API_KEY=prod-internal-secret-key-9988

# External A2A Agent Configuration
EXTERNAL_A2A_ENDPOINT=http://localhost:9000/.well-known/agent-card.json
EXTERNAL_A2A_TOKEN=a2a-shared-bearer-token-7766
EXTERNAL_A2A_TIMEOUT=90

# Remote MCP Playground Complex Server URL (used by External A2A Agent)
REMOTE_MCP_URL=https://mcpplaygroundonline.com/mcp-complex-server
